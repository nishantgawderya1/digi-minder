# Copy this file to .env.local and fill in values for your chosen backend.

# Google-only authentication
VITE_GOOGLE_CLIENT_ID=""

# API used by the frontend once the backend is added
VITE_API_BASE_URL="http://localhost:3000"

# Future AWS-backed document storage and PostgreSQL services should be configured
# on the server side, not exposed through VITE_* client variables.
